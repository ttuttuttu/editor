<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>캐릭터 시트 · 문답 카드 · 관계도</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=Gowun+Batang:wght@400;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
  :root{
    --bg:#f2f1ee; --panel:#faf9f7; --line:#e3e1dc;
    --card:#ffffff; --ink:#2b2b2b; --accent:#8c4a5a;
    /* JS가 헥스 3색에서 자동 계산 (이미지 저장 호환) */
    --ink-40:rgba(43,43,43,.40); --ink-48:rgba(43,43,43,.48); --ink-55:rgba(43,43,43,.55);
    --ink-62:rgba(43,43,43,.62); --ink-75:rgba(43,43,43,.75);
    --accent-tint:#f6eef0; --track-bg:#efe1e5; --accent-soft:rgba(140,74,90,.45);
  }
  *{box-sizing:border-box}
  html{ -webkit-text-size-adjust:100%; }
  body{
    margin:0; background:var(--bg); color:#333;
    font-family:'Noto Sans KR',sans-serif;
    min-height:100vh; display:flex; flex-direction:column;
    overflow-x:hidden;
  }

  /* ── 상단 모드 전환 (중앙) ── */
  .topbar{
    padding:18px 0 14px; display:flex; justify-content:center;
    border-bottom:1px solid var(--line); background:var(--panel);
  }
  .modes{ display:flex; border:1px solid #2b2b2b; border-radius:22px; overflow:hidden; }
  .modes button{
    font:inherit; font-size:13px; padding:8px 18px; cursor:pointer;
    background:#fff; color:#2b2b2b; border:none;
  }
  .modes button+button{ border-left:1px solid var(--line); }
  .modes button[aria-pressed="true"]{ background:#2b2b2b; color:#fff; }

  .work{ flex:1; display:grid; grid-template-columns:340px 1fr; }
  @media (max-width:880px){ .work{ grid-template-columns:1fr; } }

  /* ── 폼 ── */
  .form{
    padding:20px 20px 44px; border-right:1px solid var(--line);
    background:var(--panel); display:flex; flex-direction:column; gap:14px;
  }
  @media (max-width:880px){ .form{ border-right:none; border-bottom:1px solid var(--line); } }
  .fgroup{ display:flex; flex-direction:column; gap:5px; }
  .fgroup label{ font-size:11.5px; letter-spacing:.12em; color:#8a8781; font-weight:500; }
  .fgroup input[type=text], .fgroup textarea{
    font:inherit; font-size:14px; padding:8px 11px;
    border:1px solid var(--line); border-radius:7px;
    background:#fff; color:#2b2b2b; outline:none; width:100%;
  }
  .fgroup input:focus, .fgroup textarea:focus{ border-color:#2b2b2b; }
  .fgroup textarea{ resize:vertical; min-height:56px; }
  .hint{ font-size:11px; color:#a09c95; }
  .sep{ border:none; border-top:1px dashed var(--line); margin:4px 0; }

  /* 모바일 확대 튐 방지: 16px 미만 입력칸 포커스시 iOS가 화면을 확대함 */
  @media (max-width:880px){
    .fgroup input[type=text], .fgroup textarea,
    .row2 input, .row3 input, .row3 select,
    .hexrow input[type=text]{ font-size:16px; }
  }

  /* 헥스 입력 */
  .hexrow{ display:grid; grid-template-columns:64px 1fr 34px; gap:8px; align-items:center; }
  .hexrow .hname{ font-size:12.5px; }
  .hexrow input[type=text]{
    font-family:monospace; font-size:13px; padding:7px 10px;
    border:1px solid var(--line); border-radius:7px; outline:none; width:100%;
  }
  .hexrow input[type=text]:focus{ border-color:#2b2b2b; }
  .hexrow .sw{ width:30px; height:30px; border-radius:7px; border:1px solid var(--line); }

  /* 동적 행 공통 */
  .rows{ display:flex; flex-direction:column; gap:8px; }
  .row2{ display:grid; grid-template-columns:88px 1fr 26px; gap:7px; align-items:center; }
  .row2 input{
    font:inherit; font-size:13px; padding:7px 10px;
    border:1px solid var(--line); border-radius:7px; background:#fff; outline:none; width:100%;
  }
  .rowQ{ display:grid; grid-template-columns:1fr 26px; gap:7px; align-items:start; }
  .rowQ .qa{ display:flex; flex-direction:column; gap:5px; }
  .rowQ input, .rowQ textarea{
    font:inherit; font-size:13px; padding:7px 10px;
    border:1px solid var(--line); border-radius:7px; background:#fff; outline:none; width:100%;
  }
  .rowQ textarea{ resize:vertical; min-height:44px; }
  .row3{ display:grid; grid-template-columns:1fr 1fr 26px; gap:7px; align-items:center; }
  .row3 select{
    font:inherit; font-size:13px; padding:7px 6px;
    border:1px solid var(--line); border-radius:7px; background:#fff; outline:none; width:100%;
  }
  .row3 input{
    grid-column:1 / span 2;
    font:inherit; font-size:13px; padding:7px 10px;
    border:1px solid var(--line); border-radius:7px; background:#fff; outline:none; width:100%;
  }
  .del{
    width:26px; height:26px; border-radius:50%; cursor:pointer;
    border:1px solid var(--line); background:#fff; font-size:13px; line-height:1;
    align-self:center;
  }
  .addrow{
    align-self:flex-start; font:inherit; font-size:12px; cursor:pointer;
    padding:6px 14px; border-radius:16px;
    border:1px dashed #2b2b2b; background:transparent; color:#2b2b2b;
  }
  input:focus, textarea:focus, select:focus{ border-color:#2b2b2b !important; }

  /* 사진 편집 */
  .photoedit{ display:flex; flex-direction:column; gap:8px; padding:10px; border:1px solid var(--line); border-radius:9px; background:#fff; }
  .photoedit .prow{ display:flex; align-items:center; gap:8px; }
  .photoedit .prow span{ font-size:11.5px; color:#8a8781; width:34px; }
  .photoedit input[type=range]{ flex:1; accent-color:#2b2b2b; }
  .photoedit .pbtns{ display:flex; gap:6px; }
  .photoedit .pbtns button{
    font:inherit; font-size:12px; padding:5px 12px; cursor:pointer;
    border:1px solid var(--line); border-radius:14px; background:#fff;
  }

  /* ── 미리보기 ── */
  .stage{ padding:36px 26px 46px; display:flex; flex-direction:column; align-items:center; gap:22px; }
  @media (max-width:880px){ .stage{ padding:26px 14px 40px; } }

  .card{
    width:min(560px,94vw);
    background:var(--card); color:var(--ink);
    border:1px solid var(--line); border-radius:16px;
    padding:34px 36px 28px;
    box-shadow:0 18px 40px -28px rgba(0,0,0,.45);
  }
  @media (max-width:880px){ .card{ padding:28px 22px 24px; } }
  .eyebrow{
    text-align:center; font-size:11px; letter-spacing:.3em;
    color:var(--accent); margin-bottom:14px; font-weight:500;
  }
  .rule{ border:none; border-top:1px solid var(--line); margin:14px 0; }
  .tags{ display:flex; gap:7px; flex-wrap:wrap; justify-content:center; margin-top:16px; }
  .tag{ font-size:12px; padding:4px 12px; border-radius:14px; border:1px solid var(--accent); color:var(--accent); }
  .footline{ margin-top:18px; font-size:10.5px; letter-spacing:.22em; color:var(--ink-48); }

  /* ══ 캐릭터 시트 ══ */
  .chead{ display:flex; gap:20px; align-items:center; }
  .pframe{
    flex:none; width:104px; height:104px; border-radius:50%;
    border:1.5px solid var(--accent); background-color:var(--accent-tint);
    background-repeat:no-repeat; overflow:hidden;
    cursor:grab; touch-action:none;
    display:flex; align-items:center; justify-content:center;
    font-size:11px; color:var(--ink-40);
  }
  .pframe:active{ cursor:grabbing; }
  .cid .cname{ font-family:'Gowun Batang',serif; font-weight:700; font-size:27px; line-height:1.25; }
  .cid .calias{ font-size:12.5px; color:var(--accent); letter-spacing:.1em; margin-top:3px; }
  .infogrid{ display:grid; grid-template-columns:1fr 1fr; gap:8px 14px; margin-top:4px; }
  @media (max-width:520px){ .infogrid{ grid-template-columns:1fr; } }
  .inf{ display:flex; gap:8px; align-items:baseline; font-size:13px; }
  .inf .k{ flex:none; font-size:11px; letter-spacing:.14em; color:var(--accent); font-weight:500; min-width:44px; }
  .sect{ margin-top:14px; }
  .sect .sh{ font-size:11px; letter-spacing:.24em; color:var(--accent); font-weight:500; margin-bottom:5px; }
  .sect .sb{ font-size:13.5px; line-height:1.8; white-space:pre-wrap; }
  .quote{
    margin-top:16px; padding:12px 15px; border-left:2.5px solid var(--accent);
    background:var(--accent-tint); border-radius:0 10px 10px 0;
    font-family:'Gowun Batang',serif; font-size:14px; line-height:1.7; white-space:pre-wrap;
  }

  /* ══ 문답 카드 ══ */
  .qtitle{ text-align:center; font-family:'Gowun Batang',serif; font-weight:700; font-size:24px; }
  .qsub{ text-align:center; font-size:12.5px; color:var(--ink-55); margin-top:4px; }
  .qlist{ display:flex; flex-direction:column; gap:16px; margin-top:6px; }
  .qitem .qq{ display:flex; gap:9px; align-items:baseline; }
  .qitem .qn{ font-size:11px; color:var(--accent); font-weight:700; letter-spacing:.06em; }
  .qitem .qt{ font-size:14px; font-weight:500; }
  .qitem .qa2{ margin-top:5px; padding-left:26px; font-size:13.5px; line-height:1.75; color:var(--ink-75); white-space:pre-wrap; }

  /* ══ 관계도 ══ */
  .maptitle{ text-align:center; font-family:'Gowun Batang',serif; font-weight:700; font-size:22px; margin-bottom:4px; }
  .maparea{
    position:relative; width:100%; height:400px; margin-top:10px;
    border:1px dashed var(--line); border-radius:12px;
    overflow:hidden; touch-action:none;
  }
  .mline{
    position:absolute; height:1.5px; background:var(--accent-soft);
    transform-origin:0 50%; pointer-events:none;
  }
  .mlabel{
    position:absolute; transform:translate(-50%,-50%);
    font-size:10.5px; color:var(--accent); background:var(--card);
    padding:2px 8px; border-radius:10px; border:1px solid var(--accent);
    pointer-events:none; white-space:nowrap; max-width:120px; overflow:hidden; text-overflow:ellipsis;
  }
  .mnode{
    position:absolute; transform:translate(-50%,-50%);
    padding:7px 15px; border-radius:18px;
    background:var(--card); border:1.5px solid var(--accent);
    font-family:'Gowun Batang',serif; font-weight:700; font-size:14px; color:var(--ink);
    cursor:grab; touch-action:none; user-select:none; white-space:nowrap;
    box-shadow:0 3px 10px -6px rgba(0,0,0,.4);
  }
  .mnode:active{ cursor:grabbing; }

  /* ── 출력 ── */
  .outbar{ display:flex; gap:10px; flex-wrap:wrap; justify-content:center; }
  .out{
    font:inherit; font-size:13px; cursor:pointer;
    padding:9px 20px; border-radius:20px;
    border:1px solid #2b2b2b; background:#fff; color:#2b2b2b;
  }
  .out:hover{ background:#2b2b2b; color:#fff; }

  .toast{
    position:fixed; left:50%; bottom:24px; transform:translateX(-50%) translateY(16px);
    background:#2b2b2b; color:#fff; padding:9px 18px; border-radius:18px;
    font-size:12.5px; opacity:0; pointer-events:none; transition:.25s ease; z-index:80;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
  .hidden{ display:none !important; }
  .no-edge{ border:none !important; box-shadow:none !important; }
  @media (prefers-reduced-motion:reduce){ *{ transition:none !important; } }
</style>
</head>
<body>

  <div class="topbar">
    <div class="modes" role="tablist">
      <button id="mChar" aria-pressed="true">캐릭터 시트</button>
      <button id="mQa" aria-pressed="false">문답 카드</button>
      <button id="mMap" aria-pressed="false">관계도</button>
    </div>
  </div>

  <div class="work">
    <!-- ══════════ 폼 ══════════ -->
    <div class="form">

      <div class="fgroup">
        <label>색 (헥스코드)</label>
        <div class="hexrow"><span class="hname">배경</span><input type="text" id="hexCard" value="#ffffff" maxlength="7"><div class="sw" id="swCard"></div></div>
        <div class="hexrow"><span class="hname">글자</span><input type="text" id="hexInk" value="#2b2b2b" maxlength="7"><div class="sw" id="swInk"></div></div>
        <div class="hexrow"><span class="hname">포인트</span><input type="text" id="hexAccent" value="#8c4a5a" maxlength="7"><div class="sw" id="swAccent"></div></div>
      </div>
      <hr class="sep">

      <!-- ── 캐릭터 시트 폼 ── -->
      <div id="formChar" style="display:flex; flex-direction:column; gap:14px;">
        <div class="fgroup">
          <label>사진 (선택)</label>
          <div class="photoedit">
            <div class="pbtns"><button id="pu0">사진 올리기</button><button id="px0">지우기</button></div>
            <div class="prow"><span>확대</span><input type="range" id="pz0" min="100" max="300" value="100"></div>
            <div class="hint">사진을 드래그하면 위치를 옮길 수 있어요 · 안 올리면 칸이 사라져요</div>
          </div>
          <input type="file" id="pf0" accept="image/*" class="hidden">
        </div>
        <div class="fgroup"><label>이름</label><input type="text" id="cName" placeholder="홍길동"></div>
        <div class="fgroup"><label>이명 · 별칭</label><input type="text" id="cAlias" placeholder="예: 활빈당의 그림자"></div>
        <div class="fgroup">
          <label>기본 정보</label>
          <div class="rows" id="infoRows"></div>
          <button class="addrow" id="addInfo">+ 정보 추가</button>
          <div class="hint">라벨과 값 둘 다 있어야 카드에 나와요</div>
        </div>
        <div class="fgroup"><label>외형</label><textarea id="cLook" placeholder="키·머리색·인상 같은 겉모습 묘사"></textarea></div>
        <div class="fgroup"><label>성격</label><textarea id="cPers" placeholder="성격, 버릇, 대인관계 방식"></textarea></div>
        <div class="fgroup"><label>이야기</label><textarea id="cStory" placeholder="배경 서사, 과거, 현재 상황"></textarea></div>
        <div class="fgroup"><label>대사 · 말버릇</label><textarea id="cQuote" placeholder="카드 하단에 인용구처럼 들어가요"></textarea></div>
        <div class="fgroup"><label>태그 (쉼표로 구분)</label><input type="text" id="cTags" placeholder="의적, 밤, 변장"></div>
        <div class="fgroup"><label>하단 표기</label><input type="text" id="cFoot" placeholder="예: CHARACTER SHEET NO.01"></div>
      </div>

      <!-- ── 문답 카드 폼 ── -->
      <div id="formQa" class="hidden" style="flex-direction:column; gap:14px;">
        <div class="fgroup"><label>제목</label><input type="text" id="qTitle" placeholder="홍길동 문답"></div>
        <div class="fgroup"><label>부제</label><input type="text" id="qSub" placeholder="예: 스무고개 대신 열 문답"></div>
        <div class="fgroup">
          <label>문답</label>
          <div class="rows" id="qaRows"></div>
          <button class="addrow" id="addQa">+ 문답 추가</button>
          <div class="hint">질문이 비어 있으면 카드에서 빠져요</div>
        </div>
        <div class="fgroup"><label>하단 표기</label><input type="text" id="qFoot" placeholder="예: Q&A CARD"></div>
      </div>

      <!-- ── 관계도 폼 ── -->
      <div id="formMap" class="hidden" style="flex-direction:column; gap:14px;">
        <div class="fgroup"><label>제목</label><input type="text" id="mTitle" placeholder="관계도"></div>
        <div class="fgroup">
          <label>인물</label>
          <div class="rows" id="charRows"></div>
          <button class="addrow" id="addChar">+ 인물 추가</button>
        </div>
        <div class="fgroup">
          <label>관계 (누가 → 누구, 어떤 사이)</label>
          <div class="rows" id="relRows"></div>
          <button class="addrow" id="addRel">+ 관계 추가</button>
          <div class="hint">오른쪽 지도에서 이름표를 드래그해 배치를 바꿀 수 있어요</div>
        </div>
        <button class="addrow" id="arrange">○ 동그랗게 재정렬</button>
      </div>

    </div>

    <!-- ══════════ 미리보기 ══════════ -->
    <div class="stage">

      <!-- 캐릭터 시트 -->
      <div class="card" id="charView">
        <div class="eyebrow">CHARACTER SHEET</div>
        <div class="chead">
          <div class="pframe hidden" id="fr0"></div>
          <div class="cid">
            <div class="cname" id="vCName">이름</div>
            <div class="calias" id="vCAlias"></div>
          </div>
        </div>
        <hr class="rule">
        <div class="infogrid" id="vInfo"></div>
        <div class="sect hidden" id="sLook"><div class="sh">외형</div><div class="sb" id="vLook"></div></div>
        <div class="sect hidden" id="sPers"><div class="sh">성격</div><div class="sb" id="vPers"></div></div>
        <div class="sect hidden" id="sStory"><div class="sh">이야기</div><div class="sb" id="vStory"></div></div>
        <div class="quote hidden" id="vCQuote"></div>
        <div class="tags" id="vCTags"></div>
        <div class="footline" id="vCFoot"></div>
      </div>

      <!-- 문답 카드 -->
      <div class="card hidden" id="qaView">
        <div class="eyebrow">Q &amp; A</div>
        <div class="qtitle" id="vQTitle">제목</div>
        <div class="qsub" id="vQSub"></div>
        <hr class="rule">
        <div class="qlist" id="vQList"></div>
        <div class="footline" id="vQFoot"></div>
      </div>

      <!-- 관계도 -->
      <div class="card hidden" id="mapView">
        <div class="eyebrow">RELATION MAP</div>
        <div class="maptitle" id="vMTitle">관계도</div>
        <div class="maparea" id="maparea"></div>
      </div>

      <div class="outbar">
        <button class="out" id="pngEdge">테두리 포함 저장</button>
        <button class="out" id="pngNoEdge">테두리 없이 저장</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

<script>
(function(){
  const $ = id => document.getElementById(id);
  const rootS = document.documentElement.style;
  const toast = $('toast');
  function flash(m){ toast.textContent=m; toast.classList.add('show'); setTimeout(()=>toast.classList.remove('show'),1500); }
  function esc(s){ const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }

  /* ══ 헥스 → 파생색 ══ */
  const HEX=[
    {inp:'hexCard', sw:'swCard', varName:'--card'},
    {inp:'hexInk', sw:'swInk', varName:'--ink'},
    {inp:'hexAccent', sw:'swAccent', varName:'--accent'},
  ];
  function hexToRgb(v){
    v=v.trim(); if(v[0]==='#') v=v.slice(1);
    if(v.length===3) v=v.split('').map(c=>c+c).join('');
    if(!/^[0-9a-fA-F]{6}$/.test(v)) return null;
    return [parseInt(v.slice(0,2),16),parseInt(v.slice(2,4),16),parseInt(v.slice(4,6),16)];
  }
  function blend(a,p,b){ return a.map((c,i)=>Math.round(c*p + b[i]*(1-p))); }
  function applyHex(){
    HEX.forEach(h=>{
      let v=$(h.inp).value.trim();
      if(v && v[0]!=='#') v='#'+v;
      if(/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(v)){
        rootS.setProperty(h.varName, v);
        $(h.sw).style.background=v;
      }
    });
    const ink=hexToRgb($('hexInk').value)||[43,43,43];
    const card=hexToRgb($('hexCard').value)||[255,255,255];
    const accent=hexToRgb($('hexAccent').value)||[140,74,90];
    [40,48,55,62,75].forEach(a=>
      rootS.setProperty('--ink-'+a,'rgba('+ink[0]+','+ink[1]+','+ink[2]+','+(a/100)+')'));
    rootS.setProperty('--accent-soft','rgba('+accent[0]+','+accent[1]+','+accent[2]+',.45)');
    const tint=blend(accent,0.08,card);
    rootS.setProperty('--accent-tint','rgb('+tint.join(',')+')');
  }
  HEX.forEach(h=>$(h.inp).addEventListener('input',()=>{ applyHex(); save(); }));

  /* ══ 모드 ══ */
  let mode='char';
  const MODES={ char:['mChar','formChar','charView'], qa:['mQa','formQa','qaView'], map:['mMap','formMap','mapView'] };
  function setMode(m){
    mode=m;
    Object.entries(MODES).forEach(([k,[btn,form,view]])=>{
      $(btn).setAttribute('aria-pressed', String(k===m));
      $(form).classList.toggle('hidden', k!==m);
      $(form).style.display = k===m ? 'flex' : '';
      $(view).classList.toggle('hidden', k!==m);
    });
    if(m==='map') renderMap();
    save();
  }
  $('mChar').addEventListener('click',()=>setMode('char'));
  $('mQa').addEventListener('click',()=>setMode('qa'));
  $('mMap').addEventListener('click',()=>setMode('map'));

  /* ═══════════ ① 캐릭터 시트 ═══════════ */
  /* 사진 */
  const photo={data:null, zoom:100, x:50, y:50};
  function loadPhoto(file){
    const r=new FileReader();
    r.onload=()=>{
      const img=new Image();
      img.onload=()=>{
        const MAX=900, sc=Math.min(1, MAX/Math.max(img.width,img.height));
        const cv=document.createElement('canvas');
        cv.width=Math.round(img.width*sc); cv.height=Math.round(img.height*sc);
        cv.getContext('2d').drawImage(img,0,0,cv.width,cv.height);
        photo.data=cv.toDataURL('image/jpeg',0.88);
        photo.zoom=100; photo.x=50; photo.y=50; $('pz0').value=100;
        renderPhoto(); save();
      };
      img.src=r.result;
    };
    r.readAsDataURL(file);
  }
  $('pu0').addEventListener('click',()=>$('pf0').click());
  $('pf0').addEventListener('change',e=>{ const f=e.target.files[0]; if(f) loadPhoto(f); e.target.value=''; });
  $('px0').addEventListener('click',()=>{ photo.data=null; renderPhoto(); save(); });
  $('pz0').addEventListener('input',e=>{ photo.zoom=+e.target.value; renderPhoto(); save(); });
  function renderPhoto(){
    const fr=$('fr0');
    fr.classList.toggle('hidden', !photo.data);
    if(photo.data){
      fr.style.backgroundImage='url('+photo.data+')';
      fr.style.backgroundSize=photo.zoom+'%';
      fr.style.backgroundPosition=photo.x+'% '+photo.y+'%';
    }
  }
  (function(){
    const fr=$('fr0'); let drag=null;
    fr.addEventListener('pointerdown',e=>{
      if(!photo.data) return;
      drag={sx:e.clientX, sy:e.clientY, ox:photo.x, oy:photo.y};
      fr.setPointerCapture(e.pointerId);
    });
    fr.addEventListener('pointermove',e=>{
      if(!drag) return;
      const rect=fr.getBoundingClientRect();
      photo.x=Math.max(0,Math.min(100, drag.ox-(e.clientX-drag.sx)/rect.width*100));
      photo.y=Math.max(0,Math.min(100, drag.oy-(e.clientY-drag.sy)/rect.height*100));
      renderPhoto();
    });
    fr.addEventListener('pointerup',()=>{ drag=null; save(); });
    fr.addEventListener('pointercancel',()=>{ drag=null; });
  })();

  /* 기본 정보 행 */
  const DEFAULT_INFO=[['나이',''],['생일',''],['키',''],['직업','']];
  const infoRows=$('infoRows');
  function addInfoRow(k='', v=''){
    const row=document.createElement('div'); row.className='row2';
    const kI=document.createElement('input'); kI.type='text'; kI.placeholder='라벨'; kI.value=k;
    const vI=document.createElement('input'); vI.type='text'; vI.placeholder='값'; vI.value=v;
    const del=document.createElement('button'); del.className='del'; del.textContent='×'; del.title='삭제';
    del.addEventListener('click',()=>{ row.remove(); renderChar(); save(); });
    [kI,vI].forEach(el=>el.addEventListener('input',()=>{ renderChar(); save(); }));
    row.append(kI,vI,del); infoRows.appendChild(row);
  }
  $('addInfo').addEventListener('click',()=>addInfoRow());
  function infoData(){
    return [...infoRows.children].map(r=>{
      const [k,v]=r.querySelectorAll('input');
      return {k:k.value.trim(), v:v.value.trim()};
    }).filter(i=>i.k&&i.v);
  }

  function renderChar(){
    $('vCName').textContent=$('cName').value||'이름';
    const al=$('cAlias').value.trim();
    $('vCAlias').textContent=al; $('vCAlias').style.display=al?'':'none';
    $('vInfo').innerHTML=infoData().map(i=>
      '<div class="inf"><span class="k">'+esc(i.k)+'</span><span>'+esc(i.v)+'</span></div>').join('');
    [['cLook','sLook','vLook'],['cPers','sPers','vPers'],['cStory','sStory','vStory']].forEach(([inp,sec,out])=>{
      const t=$(inp).value.trim();
      $(sec).classList.toggle('hidden', !t);
      $(out).textContent=t;
    });
    const q=$('cQuote').value.trim();
    $('vCQuote').classList.toggle('hidden', !q); $('vCQuote').textContent=q;
    const tags=$('cTags').value.split(',').map(t=>t.trim()).filter(Boolean);
    $('vCTags').innerHTML=tags.map(t=>'<span class="tag">'+esc(t)+'</span>').join('');
    $('vCTags').style.display=tags.length?'':'none';
    const f=$('cFoot').value.trim();
    $('vCFoot').textContent=f; $('vCFoot').style.display=f?'':'none';
  }
  ['cName','cAlias','cLook','cPers','cStory','cQuote','cTags','cFoot'].forEach(id=>
    $(id).addEventListener('input',()=>{ renderChar(); save(); }));

  /* ═══════════ ② 문답 카드 ═══════════ */
  const DEFAULT_QA=[
    ['가장 좋아하는 시간대는?',''],
    ['최근에 마음에 남은 말은?',''],
    ['이것만은 절대 못 참는다?',''],
  ];
  const qaRows=$('qaRows');
  function addQaRow(q='', a=''){
    const row=document.createElement('div'); row.className='rowQ';
    const box=document.createElement('div'); box.className='qa';
    const qI=document.createElement('input'); qI.type='text'; qI.placeholder='질문'; qI.value=q;
    const aI=document.createElement('textarea'); aI.placeholder='답'; aI.value=a;
    const del=document.createElement('button'); del.className='del'; del.textContent='×'; del.title='삭제';
    del.addEventListener('click',()=>{ row.remove(); renderQa(); save(); });
    [qI,aI].forEach(el=>el.addEventListener('input',()=>{ renderQa(); save(); }));
    box.append(qI,aI); row.append(box,del); qaRows.appendChild(row);
  }
  $('addQa').addEventListener('click',()=>addQaRow());
  function qaData(){
    return [...qaRows.children].map(r=>{
      const q=r.querySelector('input'), a=r.querySelector('textarea');
      return {q:q.value.trim(), a:a.value.trim()};
    }).filter(x=>x.q);
  }
  function renderQa(){
    $('vQTitle').textContent=$('qTitle').value||'문답';
    const s=$('qSub').value.trim();
    $('vQSub').textContent=s; $('vQSub').style.display=s?'':'none';
    $('vQList').innerHTML=qaData().map((x,i)=>
      '<div class="qitem"><div class="qq"><span class="qn">'+String(i+1).padStart(2,'0')+'</span>'+
      '<span class="qt">'+esc(x.q)+'</span></div>'+
      (x.a?'<div class="qa2">'+esc(x.a)+'</div>':'')+'</div>').join('');
    const f=$('qFoot').value.trim();
    $('vQFoot').textContent=f; $('vQFoot').style.display=f?'':'none';
  }
  ['qTitle','qSub','qFoot'].forEach(id=>$(id).addEventListener('input',()=>{ renderQa(); save(); }));

  /* ═══════════ ③ 관계도 ═══════════ */
  let chars=[];  // {id, name}
  let rels=[];   // {a, b, label}
  let pos={};    // id -> {x,y} (%)
  let nextId=1;

  const charRows=$('charRows'), relRows=$('relRows');

  function addChar(name=''){
    const c={id:'c'+(nextId++), name};
    chars.push(c);
    const row=document.createElement('div'); row.className='row2';
    row.style.gridTemplateColumns='1fr 26px';
    const nI=document.createElement('input'); nI.type='text'; nI.placeholder='홍길동'; nI.value=name;
    nI.addEventListener('input',()=>{
      c.name=nI.value;
      refreshRelSelects();
      renderMap(); save();
    });
    const del=document.createElement('button'); del.className='del'; del.textContent='×'; del.title='삭제';
    del.addEventListener('click',()=>{
      chars=chars.filter(x=>x.id!==c.id);
      rels=rels.filter(r=>r.a!==c.id && r.b!==c.id);
      delete pos[c.id];
      row.remove(); rebuildRelRows(); renderMap(); save();
    });
    row.append(nI,del); charRows.appendChild(row);
    refreshRelSelects();
    return c;
  }
  $('addChar').addEventListener('click',()=>{ addChar(); renderMap(); save(); });

  function charName(c,i){ return c.name.trim()||('인물 '+(i+1)); }

  function makeSelect(current){
    const s=document.createElement('select');
    const o0=document.createElement('option'); o0.value=''; o0.textContent='— 선택 —';
    s.appendChild(o0);
    chars.forEach((c,i)=>{
      const o=document.createElement('option');
      o.value=c.id; o.textContent=charName(c,i);
      if(c.id===current) o.selected=true;
      s.appendChild(o);
    });
    return s;
  }
  function refreshRelSelects(){
    [...relRows.querySelectorAll('select')].forEach(s=>{
      const cur=s.value;
      s.innerHTML='';
      const o0=document.createElement('option'); o0.value=''; o0.textContent='— 선택 —';
      s.appendChild(o0);
      chars.forEach((c,i)=>{
        const o=document.createElement('option');
        o.value=c.id; o.textContent=charName(c,i);
        s.appendChild(o);
      });
      s.value = chars.some(c=>c.id===cur) ? cur : '';
    });
  }

  function addRel(a='', b='', label=''){
    const r={a,b,label};
    rels.push(r);
    const row=document.createElement('div'); row.className='row3';
    const sA=makeSelect(a), sB=makeSelect(b);
    const lI=document.createElement('input'); lI.type='text'; lI.placeholder='관계 (예: 앙숙)'; lI.value=label;
    const del=document.createElement('button'); del.className='del'; del.textContent='×'; del.title='삭제';
    del.addEventListener('click',()=>{ rels=rels.filter(x=>x!==r); row.remove(); renderMap(); save(); });
    sA.addEventListener('input',()=>{ r.a=sA.value; renderMap(); save(); });
    sB.addEventListener('input',()=>{ r.b=sB.value; renderMap(); save(); });
    lI.addEventListener('input',()=>{ r.label=lI.value; renderMap(); save(); });
    row.append(sA,sB,lI,del);
    relRows.appendChild(row);
  }
  $('addRel').addEventListener('click',()=>addRel());

  function rebuildRelRows(){
    relRows.innerHTML='';
    const old=rels; rels=[];
    old.forEach(r=>addRel(r.a,r.b,r.label));
  }

  /* 배치 */
  function arrangeCircle(){
    const n=chars.length;
    chars.forEach((c,i)=>{
      const ang=-Math.PI/2 + i*(2*Math.PI/Math.max(n,1));
      pos[c.id]={ x:50+38*Math.cos(ang), y:50+38*Math.sin(ang) };
    });
  }
  $('arrange').addEventListener('click',()=>{ arrangeCircle(); renderMap(); save(); });

  const area=$('maparea');
  function renderMap(){
    $('vMTitle').textContent=$('mTitle').value||'관계도';
    chars.forEach(c=>{ if(!pos[c.id]) arrangeCircle(); });
    area.innerHTML='';
    const W=area.clientWidth, H=area.clientHeight;
    if(!W) return;
    /* 선 + 라벨 */
    rels.forEach(r=>{
      if(!r.a||!r.b||r.a===r.b) return;
      const pa=pos[r.a], pb=pos[r.b];
      if(!pa||!pb) return;
      const x1=pa.x/100*W, y1=pa.y/100*H, x2=pb.x/100*W, y2=pb.y/100*H;
      const dx=x2-x1, dy=y2-y1;
      const dist=Math.sqrt(dx*dx+dy*dy), ang=Math.atan2(dy,dx)*180/Math.PI;
      const line=document.createElement('div'); line.className='mline';
      line.style.left=x1+'px'; line.style.top=y1+'px';
      line.style.width=dist+'px'; line.style.transform='rotate('+ang+'deg)';
      area.appendChild(line);
      if(r.label.trim()){
        const lb=document.createElement('div'); lb.className='mlabel';
        lb.style.left=(x1+x2)/2+'px'; lb.style.top=(y1+y2)/2+'px';
        lb.textContent=r.label.trim();
        area.appendChild(lb);
      }
    });
    /* 노드 */
    chars.forEach((c,i)=>{
      const p=pos[c.id];
      const nd=document.createElement('div'); nd.className='mnode';
      nd.style.left=p.x+'%'; nd.style.top=p.y+'%';
      nd.textContent=charName(c,i);
      let drag=null;
      nd.addEventListener('pointerdown',e=>{
        drag={sx:e.clientX, sy:e.clientY, ox:p.x, oy:p.y};
        nd.setPointerCapture(e.pointerId);
      });
      nd.addEventListener('pointermove',e=>{
        if(!drag) return;
        const rect=area.getBoundingClientRect();
        p.x=Math.max(4,Math.min(96, drag.ox+(e.clientX-drag.sx)/rect.width*100));
        p.y=Math.max(5,Math.min(95, drag.oy+(e.clientY-drag.sy)/rect.height*100));
        renderMap();
      });
      nd.addEventListener('pointerup',()=>{ drag=null; save(); });
      nd.addEventListener('pointercancel',()=>{ drag=null; });
      area.appendChild(nd);
    });
  }
  $('mTitle').addEventListener('input',()=>{ renderMap(); save(); });
  window.addEventListener('resize',()=>{ if(mode==='map') renderMap(); });

  /* ══ 저장/복원 ══ */
  const KEY='trio.v1';
  function state(){
    return {
      mode, nextId,
      hex:HEX.map(h=>$(h.inp).value),
      char:Object.fromEntries(['cName','cAlias','cLook','cPers','cStory','cQuote','cTags','cFoot'].map(id=>[id,$(id).value])),
      info:[...infoRows.children].map(r=>{ const [k,v]=r.querySelectorAll('input'); return [k.value,v.value]; }),
      photo:{...photo},
      qa:{ title:$('qTitle').value, sub:$('qSub').value, foot:$('qFoot').value,
           rows:[...qaRows.children].map(r=>[r.querySelector('input').value, r.querySelector('textarea').value]) },
      map:{ title:$('mTitle').value, chars:chars.map(c=>({...c})), rels:rels.map(r=>({...r})), pos:{...pos} },
    };
  }
  function apply(s){
    if(!s) return;
    if(s.hex) HEX.forEach((h,i)=>{ if(s.hex[i]) $(h.inp).value=s.hex[i]; });
    applyHex();
    if(s.nextId) nextId=s.nextId;
    if(s.char) Object.entries(s.char).forEach(([k,v])=>{ if($(k)) $(k).value=v; });
    infoRows.innerHTML='';
    (s.info&&s.info.length? s.info : DEFAULT_INFO).forEach(([k,v])=>addInfoRow(k,v));
    if(s.photo) Object.assign(photo, s.photo);
    $('pz0').value=photo.zoom;
    if(s.qa){
      $('qTitle').value=s.qa.title||''; $('qSub').value=s.qa.sub||''; $('qFoot').value=s.qa.foot||'';
      qaRows.innerHTML='';
      (s.qa.rows&&s.qa.rows.length? s.qa.rows : DEFAULT_QA).forEach(([q,a])=>addQaRow(q,a));
    }
    if(s.map){
      $('mTitle').value=s.map.title||'';
      charRows.innerHTML=''; relRows.innerHTML='';
      chars=[]; rels=[]; pos=s.map.pos||{};
      (s.map.chars||[]).forEach(c=>{ const nc=addChar(c.name); nc.id=c.id; refreshRelSelects(); });
      /* addChar가 새 id를 만들었으니 원래 id로 되돌림 → 행 재구성 */
      chars=(s.map.chars||[]).map(c=>({...c}));
      charRows.innerHTML='';
      chars.forEach(c=>{
        const row=document.createElement('div'); row.className='row2';
        row.style.gridTemplateColumns='1fr 26px';
        const nI=document.createElement('input'); nI.type='text'; nI.placeholder='홍길동'; nI.value=c.name;
        nI.addEventListener('input',()=>{ c.name=nI.value; refreshRelSelects(); renderMap(); save(); });
        const del=document.createElement('button'); del.className='del'; del.textContent='×'; del.title='삭제';
        del.addEventListener('click',()=>{
          chars=chars.filter(x=>x.id!==c.id);
          rels=rels.filter(r=>r.a!==c.id && r.b!==c.id);
          delete pos[c.id];
          row.remove(); rebuildRelRows(); renderMap(); save();
        });
        row.append(nI,del); charRows.appendChild(row);
      });
      (s.map.rels||[]).forEach(r=>addRel(r.a,r.b,r.label));
      refreshRelSelects();
    }
    renderPhoto(); renderChar(); renderQa();
    setMode(s.mode||'char');
  }
  function save(){ try{ localStorage.setItem(KEY, JSON.stringify(state())); }catch(e){} }
  function restore(){ try{ apply(JSON.parse(localStorage.getItem(KEY)||'null')); return !!localStorage.getItem(KEY); }catch(e){ return false; } }

  /* ══ PNG 저장 (테두리 포함 / 없음) ══ */
  function exportPNG(withEdge){
    if(typeof html2canvas!=='function'){ flash('이미지 기능을 불러오지 못했습니다'); return; }
    const el = mode==='char' ? $('charView') : mode==='qa' ? $('qaView') : $('mapView');
    if(!withEdge) el.classList.add('no-edge');
    flash('저장 중…');
    html2canvas(el,{scale:3, backgroundColor:null, useCORS:true, logging:false}).then(cv=>{
      if(!withEdge) el.classList.remove('no-edge');
      const base = mode==='char' ? ($('cName').value||'캐릭터시트')
                 : mode==='qa' ? ($('qTitle').value||'문답카드') : ($('mTitle').value||'관계도');
      const name = base+(withEdge?'':'_테두리없음')+'.png';
      cv.toBlob(blob=>{
        if(!blob){ flash('이미지 저장에 실패했습니다'); return; }
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');
        a.href=url; a.download=name;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(()=>URL.revokeObjectURL(url), 4000);
        flash('저장했습니다');
      },'image/png');
    }).catch(err=>{ if(!withEdge) el.classList.remove('no-edge'); console.error(err); flash('이미지 저장에 실패했습니다'); });
  }
  $('pngEdge').addEventListener('click',()=>exportPNG(true));
  $('pngNoEdge').addEventListener('click',()=>exportPNG(false));

  /* ══ 초기화 ══ */
  applyHex();
  if(!restore()){
    DEFAULT_INFO.forEach(([k,v])=>addInfoRow(k,v));
    DEFAULT_QA.forEach(([q,a])=>addQaRow(q,a));
    addChar(); addChar();   /* 빈 인물 2칸 (자리표시: 홍길동) */
    addRel();
    arrangeCircle();
    renderPhoto(); renderChar(); renderQa();
    setMode('char');
  }
})();
</script>
</body>
</html>
